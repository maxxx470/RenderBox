# =============================================================================
# izi kit — environment reference
# =============================================================================
# Copy this file to `.env.local` (or `.env`) at the repo root, then fill in
# the values you need. Keys are grouped by:
#
#   1. REQUIRED at boot (the app refuses to start without these)
#   2. RECOMMENDED at boot (warn-only; the app boots, but breaks at first use)
#   3. OPTIONAL providers (Vercel Blob / Resend / Gemini / Google OAuth / Sentry / Upstash)
#       — entirely env-gated, the app boots and `/api/auth` works without them
#   4. TUNABLES (magic-link, upload policy, webhook/order retention …)
#
# Source of truth for the validation schema:
#   frontend/src/lib/server/env.ts (boot-time zod schema, throws on misconfig)
# =============================================================================


# =============================================================================
# 1. REQUIRED at boot
# =============================================================================

# Postgres connection — Neon's "-pooler" host routes through PgBouncer in
# transaction mode. `connection_limit=1` is REQUIRED on serverless: each
# Vercel function instance opens its own pool, and per-instance multi-conn
# pools exhaust Neon's ceiling under moderate concurrency.
#
# This kit is cloud-only: there is NO local Postgres. Create a free Neon
# project at https://neon.tech, copy the `-pooler` connection string here
# and the non-pooled string into DIRECT_URL below.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?pgbouncer=true&connection_limit=1&pool_timeout=15&sslmode=require"

# JWT signing secret — minimum 32 chars (validator rejects shorter values
# at boot). Generate with: `openssl rand -base64 48`
# Strings starting with "change-me", "secret", "test"… are rejected.
JWT_SECRET=""


# =============================================================================
# 2. RECOMMENDED at boot
# =============================================================================

# Direct (non-pooled) Postgres URL — REQUIRED for `prisma migrate deploy`.
# The pooler exhausts on long-lived migrations and breaks prepared statements.
# Without DIRECT_URL set, migrations time out or fail mid-run.
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Vercel Cron auth shared secret. Required by /api/cron/* routes.
# Generate with: `openssl rand -base64 32`
# Single shared secret across all cron handlers.
CRON_SECRET=""

# AES-256-GCM encryption key for sensitive blob fields (OAuth refresh tokens,
# integration secrets). Required once you store encrypted data — Phase 1 auth
# works without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""


# =============================================================================
# 3. APP origin / cookies
# =============================================================================

# Public origin URL — used for email link generation, OAuth callback base,
# and CORS construction. Set this per environment.
APP_URL="http://localhost:3000"

# Comma-separated additional CORS origins (when serving from multiple domains).
# Leave empty to accept only same-origin (default in a monolith).
ALLOWED_ORIGINS=""

# Cookie name prefix. All auth cookies are namespaced "${COOKIE_PREFIX}-token",
# "${COOKIE_PREFIX}-refresh", "${COOKIE_PREFIX}-csrf". Change per app so a dev
# sharing localhost across two starters doesn't clobber sessions.
COOKIE_PREFIX="app"

# Cookie domain for production (e.g. ".example.com" so cookies are shared
# across www.example.com and api.example.com). Leave empty for localhost dev.
# COOKIE_DOMAIN=""

# Mirrors COOKIE_PREFIX for the browser bundle (must be NEXT_PUBLIC_*).
NEXT_PUBLIC_COOKIE_PREFIX="app"

# Node environment. The logger redacts PII when this is "production" or any
# unknown value (fail-safe). Leave unset / "development" locally.
# NODE_ENV=development


# =============================================================================
# 4. OPTIONAL — Upstash Redis (rate limit, leader-lease, lockout, refresh-lock)
# =============================================================================
# Without these, the rate limiter falls back to an in-memory store
# (logged as `log.warn` at boot). DO NOT run in production without Upstash —
# in-memory state is per-instance and resets on every cold start.

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# =============================================================================
# 5. OPTIONAL — Email (Resend)
# =============================================================================
# Without these, the email queue (EmailJob rows) accumulates but is never
# drained — the cron `/api/cron/email-queue-drain` logs a warn and skips.
# Once the API key arrives, queued rows flush on the next cron tick.

RESEND_API_KEY=""

# Verified sender — must match a domain or address verified in your Resend
# project. Format accepts `"Name <addr@domain.com>"` or plain `addr@domain.com`.
EMAIL_FROM=""


# =============================================================================
# 6. OPTIONAL — Vercel Blob (image storage)
# =============================================================================
# Required for POST /api/projects/[id]/upload and the generation route's
# output storage — without this, both return 503 STORAGE_NOT_CONFIGURED.
#
# Create a Blob store in the Vercel dashboard (Storage → Blob) or via
# `vercel blob store add`; the token is auto-injected in Vercel deployments
# but must be set manually for local dev.
#
# ⚠️ SECURITY — Vercel Blob has no private/signed access mode: any URL is
# fetchable by anyone who has it (long random suffix, but no auth check by
# the CDN). RenderBox never exposes a raw blob URL to the client — every
# image read goes through the authenticated proxy route
# `/api/render-nodes/[id]/image`, which checks project ownership before
# streaming bytes. Do not add a direct <img src={blobUrl}> anywhere.
BLOB_READ_WRITE_TOKEN=""

# =============================================================================
# 6b. OPTIONAL — Gemini / "Nanobanana" (AI render generation)
# =============================================================================
# Required for POST /api/projects/[id]/generate — without this, the route
# returns 503 AI_ENGINE_NOT_CONFIGURED. Get a key at
# https://aistudio.google.com/apikey. Server-side only — never exposed to
# the client bundle (no NEXT_PUBLIC_ prefix, ever).
GEMINI_API_KEY=""

# =============================================================================
# 6c. OPTIONAL — OpenAI "ChatGPT Image" (second AI render engine, Phase 4)
# =============================================================================
# Required if the user picks the "ChatGPT Image" engine at generation time
# (503 AI_ENGINE_NOT_CONFIGURED for that engine specifically otherwise — the
# other engine keeps working) — AND for the Phase 5 "add element" edit,
# which moderates the uploaded reference image via OpenAI's omni-moderation
# model before forwarding it to any AI provider (fails closed: 503
# MODERATION_NOT_CONFIGURED without this key, never skips moderation
# silently). Get a key at https://platform.openai.com/api-keys. Server-side
# only — never exposed to the client bundle, and no route accepts a
# client-supplied API key.
OPENAI_API_KEY=""

# Per-user daily cap on AI generation calls (real per-call cost). Distinct
# from the auth rate limits below — this limiter guards spend, not abuse.
# Applies globally across both engines (not per-engine) — simpler to reason
# about and sufficient until usage data says otherwise.
GENERATION_RATE_LIMIT_MAX_PER_DAY="20"

# =============================================================================
# 6c. OPTIONAL — Claude Vision (material detection, Phase 2)
# =============================================================================
# Required for the automatic materials-sheet detection that runs after each
# successful generation — without this, detection is skipped silently (a
# warn is logged) and the render itself still succeeds. Get a key at
# https://console.anthropic.com/settings/keys. Server-side only.
ANTHROPIC_API_KEY=""

# Override the model used for material detection. Defaults to the latest
# Sonnet — bump this if Anthropic ships a newer default and you want to pin.
# ANTHROPIC_MODEL="claude-sonnet-5"


# =============================================================================
# 7. OPTIONAL — Google OAuth
# =============================================================================
# Get these at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). The authorized redirect URI
# in Google Console must match GOOGLE_REDIRECT_URI exactly.
# Without these, /api/auth/oauth/google/* routes return 404.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"


# =============================================================================
# 8. OPTIONAL — Maketou payments (Phase 6)
# =============================================================================
# RenderBox uses Maketou (not Bictorys) for payment. Maketou has no reliable
# webhook — POST /api/payments/checkout creates a PENDING Order and redirects
# to Maketou's hosted checkout; GET /api/payments/verify (called by the
# /paiement/retour return page) plus the /api/cron/maketou-reconcile cron
# (every 5 min) are the two places that ever mark an Order PAID, both via the
# same idempotent compare-and-swap helper (lib/server/payments/maketou-reconcile.ts).
# Without MAKETOU_API_KEY / MAKETOU_PRODUCT_ID, /api/payments/checkout returns
# 503 PAYMENT_PROVIDER_UNCONFIGURED and the reconcile cron no-ops.
#
# Manual prerequisite (not codable by an agent): create your product(s) in the
# Maketou dashboard and copy the productDocumentId here.
#
# /tarifs has 3 pricing tiers (see lib/pricing-tiers.ts for the fixed XOF
# amounts + generation quotas) — each needs its own Maketou product.
# MAKETOU_PRODUCT_ID below backs the "standard" tier (kept as the original
# var name for compat); the other two tiers are commented out until you
# create their products.
MAKETOU_API_KEY=""
MAKETOU_PRODUCT_ID=""
# MAKETOU_PRODUCT_ID_DECOUVERTE=""                 # 30 générations/mois — 6 000 FCFA
# MAKETOU_PRODUCT_ID_PRO=""                        # 300 générations/mois — 36 000 FCFA
# MAKETOU_API_BASE_URL="https://api.maketou.net"   # override for a sandbox env


# =============================================================================
# 9. OPTIONAL — Sentry (error reporting + tracing)
# =============================================================================
# Without SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN, the Sentry SDKs become silent
# no-ops (no events sent, no perf overhead).

# Server-side DSN:
SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"            # defaults to NODE_ENV
# SENTRY_RELEASE="myapp@1.2.3"               # set by CI for source-map matching
# SENTRY_TRACES_SAMPLE_RATE="0.1"            # 0.0–1.0 — default 0 (off)

# Frontend (browser) DSN — separate Sentry project recommended so client
# events don't pollute server-side dashboards.
NEXT_PUBLIC_SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_RELEASE="myapp@1.2.3"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# NEXT_PUBLIC_SENTRY_REPLAYS_SAMPLE_RATE="0"  # session replay opt-in (costly)

# Source-map upload (CI only). Without these the build still succeeds but
# stack traces won't be symbolicated in Sentry.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""


# =============================================================================
# 10. TUNABLES — Magic-link auth (RenderBox is password-less: Google OAuth +
#     magic link only)
# =============================================================================
# All optional. Defaults below are production-safe.

# Magic-link TTL in minutes. The token is a 256-bit random value, hashed
# (SHA-256) before storage in VerificationCode.code — the raw token exists
# only in the emailed URL and briefly in the request handler's memory.
AUTH_MAGIC_LINK_TTL_MIN=15

# Per-email rate limit on magic-link requests (email-cost vector — fails
# closed when Redis is absent).
AUTH_MAGIC_LINK_RATE_LIMIT_MAX=3

# Email rate-limiter behaviour when Upstash is unreachable.
# Default OFF (fail-open) — the limiter logs warn and lets the request through
# so a Redis blip doesn't take auth offline. In prod with real abuse pressure
# you probably want fail-closed (return 429). Set to "1" to enable.
AUTH_RATE_LIMIT_FAIL_CLOSED=


# =============================================================================
# 11. TUNABLES — Upload policy (applied by POST /api/projects/[id]/upload)
# =============================================================================

# Comma-separated MIME whitelist. Magic bytes verified by sniff.ts; extending
# this list to a MIME without a sniffer logs a boot warning and trusts the
# client (XSS risk on text-ish formats — your call).
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp"

# Max single-file size in bytes (15 MB default, matches the /app dropzone
# copy). Vercel Route Handlers can stream past the platform 4.5 MB body
# limit via req.formData(), but bigger files = bigger Vercel + Blob bills.
UPLOAD_MAX_BYTES="15728640"

# Per-IP upload rate limit (uploads/hour). Byte size alone doesn't stop
# someone looping the upload button — this closes that gap. Matters most
# under AUTH_DISABLED, where every visitor shares one demo userId and a
# per-user limit would be one bucket shared by the whole site.
UPLOAD_RATE_LIMIT_MAX_PER_HOUR="20"


# =============================================================================
# 12. TUNABLES — Webhook log retention + order expiration
# =============================================================================

# /api/cron/webhook-log-purge (daily) deletes WebhookLog rows older than this.
# Compliance teams sometimes want 1y or 7y retention; flip this knob without
# re-deploying. Default 90 days.
WEBHOOK_LOG_RETENTION_DAYS="90"

# Fork-customizable knob for the order-creation route to compute
# Order.expiresAt = createdAt + N minutes. The /api/cron/order-expiration
# (every 5 min) reads Order.expiresAt directly and is INDEPENDENT of this env
# — but forks adjusting checkout windows tweak this single value rather than
# the route code. Default 30 min.
ORDER_EXPIRATION_MINUTES="30"

# /api/cron/account-purge (daily) hard-deletes User rows whose soft-delete
# (deletedAt, set via DELETE /api/admin/users/[id]) is older than this many
# days. Reversible via POST /api/admin/users/[id]/restore until the purge
# runs. Default 30 days.
ACCOUNT_DELETION_GRACE_DAYS="30"


# =============================================================================
# 13. DEV-ONLY — Smoke tests and local bypasses
# =============================================================================
# These only matter when running scripts/* locally; they are NEVER read by the
# server in production. Setting them in a prod env has no effect.

# Override target host for `pnpm smoke:auth` (defaults to http://localhost:3000).
# Use against a Vercel preview deploy or a colleague's tunnel:
# SMOKE_BASE_URL="https://my-preview.vercel.app"
SMOKE_BASE_URL=""

# 1 = bypass HMAC verification in /api/webhooks/* during local smoke tests.
# NEVER set this in production — it disables the anti-replay + integrity guard.
# Used by the optional webhook-side smoke harness (not enabled in v1).
SMOKE_BYPASS_WEBHOOK_VERIFY=""

# true = skip /connexion entirely and auto-authenticate every request to
# /app and its API routes as a fixed seeded demo user (see
# lib/server/auth-disabled.ts and `pnpm seed:dev`) — role USER, never ADMIN.
# NOT gated on NODE_ENV: works on a deployed Vercel preview/production build
# exactly like local dev, since this is meant for "site under construction,
# already deployed publicly, connexion not ready yet" — set it in Vercel
# (Production AND Preview) while that's the case. /admin is never affected
# (requireAdmin always requires a real session, see lib/server/middleware/
# index.ts). Temporary/reversible: remove this var (or set it to anything but
# "true") and redeploy to restore normal auth — no code change needed.
AUTH_DISABLED=""


# =============================================================================
# 14. OPTIONAL — Banani MCP (design import workflow, see WORKFLOW.md)
# =============================================================================
# Banani is an OPTIONAL design tool. Connect it via MCP if you have designs
# already drawn — the `banani-design-implementation` skill reads your selected
# screens directly and reproduces them pixel-perfect. If you don't have a
# Banani project, ignore this section entirely and describe your screens in
# natural language to Claude instead. The setup-kit skill walks through the
# MCP connection in Phase 5 (oui / non / plus tard branching).
#
# Note: Banani gives you a free MCP connection block (no paid API key) — you
# paste the block straight into .mcp.json. This BANANI_API_KEY env var is only
# needed if the connection block Banani gives you references a token env var;
# leave empty otherwise.
BANANI_API_KEY=""
