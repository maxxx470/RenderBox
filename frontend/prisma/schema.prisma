generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  // RenderBox is password-less: Google OAuth + magic link only. Users
  // created via magic-link request never have an OAuthAccount; users
  // created via Google never set emailVerifiedAt through a code (Google's
  // own email_verified claim is the trust source there instead).
  emailVerifiedAt         DateTime?
  tokenVersion            Int       @default(0)
  // Optional display name — populated from OAuth profile on first sign-in.
  name                    String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl               String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role                    String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status                  String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // Phase 6 soft-delete. NULL = active/visible. Set by an admin via
  // DELETE /api/admin/users/[id]; reversible for ACCOUNT_DELETION_GRACE_DAYS
  // (default 30) via POST /api/admin/users/[id]/restore, after which the
  // account-purge cron hard-deletes the row. Login is refused (same 15-min
  // choke point as ACCOUNT_SUSPENDED) while deletedAt is set.
  deletedAt               DateTime?
  // Preferred generation engine, set from /parametres. NULL falls back to
  // "nanobanana" client-side (AppShell.tsx's initial engine state).
  defaultEngine           String?
  // Real, paid monthly quota (see lib/pricing-tiers.ts for the tier→quota
  // mapping) — distinct from GENERATION_RATE_LIMIT_MAX_PER_DAY's anti-abuse
  // hourly/daily cap; both gates must pass, neither replaces the other (see
  // lib/server/generation/tier-quota.ts). NULL = no active tier (never paid,
  // or the period lapsed without renewal — checkTierQuota() resets it here
  // lazily rather than via a cron, so this can go stale for up to 30 days
  // for a user who never generates again, which is harmless: it just means
  // the next attempt re-derives NULL instead of reading it pre-computed).
  currentTier             String?
  // Start of the current paid period. A renewal of the SAME tier before
  // expiry moves this to now() (extends, not stacks) rather than carrying
  // over unused generations — see tier-quota.ts's activateTier().
  tierPeriodStart         DateTime?
  generationsUsedInPeriod Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]
  projects          Project[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // For type = MAGIC_LINK, `code` holds the SHA-256 hex digest of the raw
  // 256-bit token embedded in the emailed link — never the raw token itself.
  // `attempts` is meaningless for that type (guessing a 256-bit token isn't
  // a realistic brute-force surface); it's kept for schema uniformity.
  code      String
  type      String // MAGIC_LINK
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

// ───────────────────────────────────────────────────────────────────────
// RenderBox core — Project (one building), RenderNode (each uploaded or
// generated image, tree-shaped via parentId), Material (per-facade memory),
// Generation (trace of each AI call + the materials snapshot used).
// ───────────────────────────────────────────────────────────────────────
model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  renderNodes RenderNode[]
  materials   Material[]

  @@index([userId, createdAt])
}

model RenderNode {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    RenderNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  RenderNode[] @relation("NodeTree")
  kind      String // UPLOADED | GENERATED
  // Vercel Blob URL. Vercel Blob has no private/signed access mode — this
  // field must NEVER be sent to the client directly. All reads go through
  // the authenticated proxy route (app/api/render-nodes/[id]/image) which
  // checks project ownership before streaming bytes.
  blobUrl   String
  mimeType  String
  sizeBytes Int
  // Phase 3 — which ambiance preset produced this node. Null for UPLOADED
  // nodes (no preset applies to a source photo) and for any GENERATED node
  // predating Phase 3. See lib/server/generation/presets.ts.
  preset    String?
  // Phase 4 — which engine produced this node ("nanobanana" | "gpt_image").
  // Null for UPLOADED nodes and for any GENERATED node predating Phase 4.
  // Denormalized onto RenderNode (mirroring `preset`) so the viewer's
  // per-node badge doesn't need a join through Generation.
  engine    String?
  // Phase 5 — set only when this node came from the edit route (not the
  // standard generate route). Null = a standard generation or an upload.
  editType  String? // "add_element" | "targeted_retouch" | null
  // { x, y, width, height } in percent (0-100) of the source image,
  // present only when editType = "targeted_retouch".
  editZone  Json?
  createdAt DateTime     @default(now())

  generation Generation?

  @@index([projectId, createdAt])
  @@index([parentId])
}

// One active value per (projectId, face) — @@unique both enforces that and
// gives the merge logic (lib/server/materials/merge.ts) a natural upsert
// target. `confidence` is 0-100, null when source = manuel.
model Material {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  face       String // e.g. "facade_principale", "toiture", "menuiseries"
  valeur     String // free-text material description
  source     String   @default("auto") // auto | manuel
  confidence Int? // 0-100, null when source = manuel
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, face])
}

model Generation {
  id                String     @id @default(cuid())
  nodeId            String     @unique
  node              RenderNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  engine            String // "nanobanana" | "gpt_image" — see lib/server/generation/engines/types.ts
  preset            String? // one of lib/server/generation/presets.ts's PRESET_KEYS
  prompt            String
  materialsSnapshot Json // frozen copy of Material rows at generation time
  createdAt         DateTime   @default(now())

  @@index([engine, createdAt])
}
