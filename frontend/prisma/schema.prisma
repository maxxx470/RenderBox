generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  // RenderBox is password-less: Google OAuth + magic link only. Users
  // created via magic-link request never have an OAuthAccount; users
  // created via Google never set emailVerifiedAt through a code (Google's
  // own email_verified claim is the trust source there instead).
  emailVerifiedAt         DateTime?
  tokenVersion            Int       @default(0)
  // Optional display name — populated from OAuth profile on first sign-in.
  name                    String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl               String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role                    String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status                  String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // Phase 6 soft-delete. NULL = active/visible. Set by an admin via
  // DELETE /api/admin/users/[id]; reversible for ACCOUNT_DELETION_GRACE_DAYS
  // (default 30) via POST /api/admin/users/[id]/restore, after which the
  // account-purge cron hard-deletes the row. Login is refused (same 15-min
  // choke point as ACCOUNT_SUSPENDED) while deletedAt is set.
  deletedAt               DateTime?
  // Preferred generation engine, set from /parametres. NULL falls back to
  // "nanobanana" client-side (AppShell.tsx's initial engine state).
  defaultEngine           String?
  // The version chosen for each engine, {"nanobanana":"visio-2-1", …}
  // (engine-versions.ts; NULL = the defaults). Set from the command bar's
  // version chip and from /parametres; kept on the account since 2026-10-16
  // (owner), in the browser before.
  engineVersions          Json?
  // When the user last opened the in-app Info page (2026-10-17, owner: a
  // badge on « Info » when something new is published there, « lié au
  // compte »). A film added after it counts as new; NULL = never opened,
  // the account's creation date stands in (app/app/info/info-films.ts).
  infoSeenAt              DateTime?
  // Real, paid monthly quota (see lib/pricing-tiers.ts for the tier→quota
  // mapping) — distinct from GENERATION_RATE_LIMIT_MAX_PER_DAY's anti-abuse
  // hourly/daily cap; both gates must pass, neither replaces the other (see
  // lib/server/generation/tier-quota.ts). NULL = no active tier (never paid,
  // or the period lapsed without renewal — getCreditStatus() resets it here
  // lazily rather than via a cron, so this can go stale for up to 30 days
  // for a user who never generates again, which is harmless: it just means
  // the next attempt re-derives NULL instead of reading it pre-computed).
  currentTier             String?
  // Start of the current paid period. A renewal of the SAME tier before
  // expiry moves this to now() (extends, not stacks) rather than carrying
  // over unused credits — see tier-quota.ts's activateTier().
  tierPeriodStart         DateTime?
  // Retired 2026-10-13 (renders became credits); kept, unread, so the
  // migration stays additive. Its last values were converted into
  // creditsBalance by 9_phase8_credits.
  generationsUsedInPeriod Int       @default(0)
  // Credits left in the current period (pricing-tiers.ts). Set to the plan's
  // credits on activation or renewal, debited before each generation and
  // refunded on failure, zeroed when the period lapses. Never negative (a
  // CHECK constraint in the database).
  creditsBalance          Int       @default(0)
  // Email + password sign-in (Phase 9, 2026-10-13; the starter's password
  // routes were removed by the RenderBox port and come back in a smaller
  // shape, lib/server/auth/password.ts). bcrypt hash; NULL = no password
  // (Google only). A password is only ever set AFTER the email is proved by
  // a code, so nobody can attach a password to someone else's address.
  passwordHash            String?
  // Lockout after repeated wrong passwords, kept in the database so it holds
  // across serverless instances (no Redis in production).
  failedLoginAttempts     Int       @default(0)
  lockedUntil             DateTime?
  // Onboarding (Phase 9): what the user tells RenderPro about themselves
  // after the first sign-in. `name` above holds their full name. NULL
  // onboardedAt = the onboarding has not been completed; /app sends them
  // to /bienvenue until it is.
  phone                   String?
  profession              String?
  company                 String?
  teamSize                String?
  projectTypes            String[]  @default([])
  mainUse                 String?
  country                 String?
  city                    String?
  referralSource          String?
  onboardedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]
  projects          Project[]
  supportMessages   SupportMessage[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // For type = MAGIC_LINK, `code` holds the SHA-256 hex digest of the raw
  // 256-bit token embedded in the emailed link — never the raw token itself.
  // `attempts` is meaningless for that type (guessing a 256-bit token isn't
  // a realistic brute-force surface); it's kept for schema uniformity.
  code      String
  type      String // MAGIC_LINK
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
// A conversation between a user and the RenderPro team (2026-10-17, owner):
// the in-app Assistant panel is a message box, no automatic answer. The user
// writes (fromAdmin false), an admin answers from /admin/messages (fromAdmin
// true, adminId set). readAt = read by the other side: the admin for the
// user's messages, the user for the answers.
model SupportMessage {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAdmin Boolean   @default(false)
  adminId   String?
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([fromAdmin, readAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

// ───────────────────────────────────────────────────────────────────────
// RenderBox core — Project (one building), RenderNode (each uploaded or
// generated image, tree-shaped via parentId), Material (per-facade memory),
// Generation (trace of each AI call + the materials snapshot used).
// ───────────────────────────────────────────────────────────────────────
model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  renderNodes RenderNode[]
  materials   Material[]

  @@index([userId, createdAt])
}

model RenderNode {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        RenderNode?  @relation("NodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      RenderNode[] @relation("NodeTree")
  kind          String // UPLOADED | GENERATED
  // Vercel Blob URL. Vercel Blob has no private/signed access mode — this
  // field must NEVER be sent to the client directly. All reads go through
  // the authenticated proxy route (app/api/render-nodes/[id]/image) which
  // checks project ownership before streaming bytes.
  blobUrl       String
  mimeType      String
  sizeBytes     Int
  // Phase 3 — which ambiance preset produced this node. Null for UPLOADED
  // nodes (no preset applies to a source photo) and for any GENERATED node
  // predating Phase 3. See lib/server/generation/presets.ts.
  preset        String?
  // Phase 4 — which engine produced this node ("nanobanana" | "gpt_image").
  // Null for UPLOADED nodes and for any GENERATED node predating Phase 4.
  // Denormalized onto RenderNode (mirroring `preset`) so the viewer's
  // per-node badge doesn't need a join through Generation.
  engine        String?
  // 2026-10-15 — which version of that engine made the node ("visio-2-1",
  // see lib/server/generation/engine-versions.ts). Null for uploads, older
  // renders and renders the engine's direct API made (no Kie).
  engineVersion String?
  // What Kie charged for this image, in Kie credits (its recordInfo
  // `creditsConsumed`; 2026-10-17, owner: the API usage in /admin).
  // NULL = not made through Kie (an upload, the direct engines, older images).
  providerCredits Float?
  // Phase 5 — set only when this node came from the edit route (not the
  // standard generate route). Null = a standard generation or an upload.
  // "enhance" = the /app/enhance route (no preset, see generation/enhance.ts).
  editType      String? // "add_element" | "targeted_retouch" | "enhance" | null
  // { x, y, width, height } in percent (0-100) of the source image,
  // present only when editType = "targeted_retouch".
  editZone      Json?
  createdAt     DateTime     @default(now())

  generation Generation?

  // Phase 7 — materials per image (see MaterialDetectionRun below).
  materialDetectionRun MaterialDetectionRun?
  materialDetections   MaterialDetection[]
  materialCorrections  MaterialCorrection[]
  // Old project-level Material rows explicitly attached to this image.
  legacyMaterials      Material[]            @relation("LegacyAttachment")

  @@index([projectId, createdAt])
  @@index([parentId])
}

// One active value per (projectId, face) — @@unique both enforces that and
// gives the merge logic (lib/server/materials/merge.ts) a natural upsert
// target. `confidence` is 0-100, null when source = manuel.
model Material {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  face       String // e.g. "facade_principale", "toiture", "menuiseries"
  valeur     String // free-text material description
  source     String   @default("auto") // auto | manuel
  confidence Int? // 0-100, null when source = manuel
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Phase 7 — the image this old row was explicitly attached to by the user.
  // Never filled automatically, even in a project with a single root; the
  // attach route must check the node and the row share project and owner.
  attachedNodeId String?
  attachedNode   RenderNode?         @relation("LegacyAttachment", fields: [attachedNodeId], references: [id], onDelete: SetNull)
  attachedAt     DateTime?
  correction     MaterialCorrection?

  @@unique([projectId, face])
  @@index([attachedNodeId])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 7 — materials per image. Detections and corrections belong to ONE
// RenderNode and never leak to another (lib/server/materials/resolve.ts).
//
// `face` holds the canonical key: Unicode NFKD, diacritics removed,
// lowercase, every run of non-alphanumeric characters turned into a single
// "_", no leading or trailing "_", never empty, at most 64 characters
// ("Façade principale" → "facade_principale"). The same application
// function must write every face; a CHECK constraint in the migration
// (9_phase7_materials_per_node) refuses any other shape.
// ───────────────────────────────────────────────────────────────────────

// Detection state of one image. "succeeded" with zero MaterialDetection rows
// = looked at, nothing found; no row at all = never looked at.
model MaterialDetectionRun {
  nodeId     String     @id
  node       RenderNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  status     String // pending | succeeded | failed (CHECK in the migration)
  attempts   Int        @default(0)
  // Token of the request holding the current attempt.
  claimToken String?
  // Model that ran the detection.
  detector   String?
  // Short, non-sensitive code only — never a raw error message.
  errorCode  String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  updatedAt  DateTime   @updatedAt

  @@index([status, updatedAt])
}

model MaterialDetection {
  id         String     @id @default(cuid())
  nodeId     String
  node       RenderNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  face       String // canonical key (see above)
  valeur     String
  confidence Int // 0-100 (CHECK in the migration)
  // Order the detector returned this face in.
  position   Int
  createdAt  DateTime   @default(now())

  @@unique([nodeId, face])
}

// A user's correction on one image. valeur = null is an explicit removal:
// the row stays, and the detection of that face no longer reaches the prompt.
model MaterialCorrection {
  id               String     @id @default(cuid())
  nodeId           String
  node             RenderNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  face             String // canonical key (see above)
  // Label as the user typed it, for display.
  faceLabel        String?
  valeur           String?
  origin           String     @default("user") // user | legacy_attach (CHECK in the migration)
  // The old Material row this correction was attached from (once only).
  legacyMaterialId String?    @unique
  legacyMaterial   Material?  @relation(fields: [legacyMaterialId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([nodeId, face])
}

model Generation {
  id                String     @id @default(cuid())
  nodeId            String     @unique
  node              RenderNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  engine            String // "nanobanana" | "gpt_image" — see lib/server/generation/engines/types.ts
  preset            String? // one of lib/server/generation/presets.ts's PRESET_KEYS
  prompt            String
  materialsSnapshot Json // frozen copy of Material rows at generation time
  // Phase 7 — the materials resolved for this generation's source image:
  // [{ face, valeur, origin: "detection" | "correction", nodeId, confidence? }].
  // Null for every generation made before Phase 7.
  promptMaterials   Json?
  createdAt         DateTime   @default(now())

  @@index([engine, createdAt])
}
